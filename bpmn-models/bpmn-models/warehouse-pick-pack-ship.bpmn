<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Warehouse" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="warehouse_pick_pack_ship" name="Warehouse Pick, Pack &#38; Ship" isExecutable="true">
    <bpmn:startEvent id="Start_WH" name="Warehouse job received">
      <bpmn:outgoing>Flow_W1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Register" name="Register shipment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-shipment" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId" />
          <zeebe:input source="=warehouseGroup" target="warehouseGroup" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W1</bpmn:incoming>
      <bpmn:outgoing>Flow_W2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UT_Pick" name="Pick &#38; pack items">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="warehouse-pickers" />
        <zeebe:formDefinition formId="pick-pack-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W2</bpmn:incoming>
      <bpmn:outgoing>Flow_W3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Damaged" name="Item damaged?" default="Flow_W5">
      <bpmn:incoming>Flow_W3</bpmn:incoming>
      <bpmn:outgoing>Flow_W4</bpmn:outgoing>
      <bpmn:outgoing>Flow_W5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Substitution" name="Out-of-Stock Substitution &#38; Partial Refund">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if count(refundResults) &#62; 0 then sum(refundResults.amount) else 0" target="refundTotal" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W4</bpmn:incoming>
      <bpmn:outgoing>Flow_W6</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start" name="Damage reported">
        <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_FindSub" name="Find substitute items">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="find-substitutes" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=orderId" target="orderId" />
            <zeebe:input source="=warehouseGroup.warehouseId" target="warehouseId" />
            <zeebe:input source="=damagedItems" target="damagedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S1</bpmn:incoming>
        <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="GW_SubAvail" name="Substitute available?" default="Flow_S4">
        <bpmn:incoming>Flow_S2</bpmn:incoming>
        <bpmn:outgoing>Flow_S3</bpmn:outgoing>
        <bpmn:outgoing>Flow_S4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UT_ApproveSubstitution" name="Approve substitution with customer">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="customer-support" />
          <zeebe:formDefinition formId="approve-substitution-form" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S3</bpmn:incoming>
        <bpmn:outgoing>Flow_S5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="GW_Approved" name="Customer approved?" default="Flow_S7">
        <bpmn:incoming>Flow_S5</bpmn:incoming>
        <bpmn:outgoing>Flow_S6</bpmn:outgoing>
        <bpmn:outgoing>Flow_S7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_ApplySub" name="Add substitutes to parcel">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="apply-substitution" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=orderId" target="orderId" />
            <zeebe:input source="=substitutes" target="substitutes" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S6</bpmn:incoming>
        <bpmn:outgoing>Flow_S8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Script_RefundAll" name="Refund all damaged items">
        <bpmn:extensionElements>
          <zeebe:script expression="=damagedItems" resultVariable="refundItems" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S7</bpmn:incoming>
        <bpmn:outgoing>Flow_S9</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GW_Join">
        <bpmn:incoming>Flow_S4</bpmn:incoming>
        <bpmn:incoming>Flow_S8</bpmn:incoming>
        <bpmn:incoming>Flow_S9</bpmn:incoming>
        <bpmn:outgoing>Flow_S10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_IssueRefund" name="Issue refund per item (sequential)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="issue-refund" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=orderId" target="orderId" />
            <zeebe:input source="=warehouseGroup.warehouseId" target="warehouseId" />
            <zeebe:input source="=simulateRefundFailure" target="simulateRefundFailure" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S10</bpmn:incoming>
        <bpmn:outgoing>Flow_S11</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=refundItems" inputElement="refundItem" outputCollection="refundResults" outputElement="=refundResult" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_NotifyRefund" name="Notify customer (Email)" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="8">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="smtp" target="protocol" />
            <zeebe:input source="simple" target="authentication.type" />
            <zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" />
            <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" />
            <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
            <zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" />
            <zeebe:input source="1025" target="data.smtpConfig.smtpPort" />
            <zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" />
            <zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" />
            <zeebe:input source="=customer.email" target="data.smtpAction.to" />
            <zeebe:input source="=&#34;Update on your order &#34; + orderId" target="data.smtpAction.subject" />
            <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
            <zeebe:input source="=&#34;Hello &#34; + customer.name + &#34;,\n\nWhile packing your order &#34; + orderId + &#34; at &#34; + warehouseGroup.warehouseName + &#34; we found damaged item(s).\nOutcome: &#34; + (if count(refundResults) &#62; 0 then &#34;refunded INR &#34; + string(sum(refundResults.amount)) else &#34;replaced with a substitute at no extra cost&#34;) + &#34;.\n\nFashionHub Customer Care&#34;" target="data.smtpAction.body" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="8" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
            <zeebe:header key="resultVariable" value="refundMail" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S11</bpmn:incoming>
        <bpmn:outgoing>Flow_S12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Script_Resolution" name="Determine resolution">
        <bpmn:extensionElements>
          <zeebe:script expression="=if count(refundResults) = 0 then &#34;SUBSTITUTED&#34; else if substitutionApproved then &#34;SUBSTITUTED_PARTIAL_REFUND&#34; else &#34;REFUNDED&#34;" resultVariable="resolution" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S12</bpmn:incoming>
        <bpmn:outgoing>Flow_S13</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="Sub_End" name="Resolved">
        <bpmn:incoming>Flow_S13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S1" sourceRef="Sub_Start" targetRef="Task_FindSub" />
      <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_FindSub" targetRef="GW_SubAvail" />
      <bpmn:sequenceFlow id="Flow_S3" name="Yes" sourceRef="GW_SubAvail" targetRef="UT_ApproveSubstitution">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(substitutes) &gt; 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S4" name="No substitute" sourceRef="GW_SubAvail" targetRef="GW_Join" />
      <bpmn:sequenceFlow id="Flow_S5" sourceRef="UT_ApproveSubstitution" targetRef="GW_Approved" />
      <bpmn:sequenceFlow id="Flow_S6" name="Yes" sourceRef="GW_Approved" targetRef="Task_ApplySub">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=substitutionApproved = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_S7" name="No" sourceRef="GW_Approved" targetRef="Script_RefundAll" />
      <bpmn:sequenceFlow id="Flow_S8" sourceRef="Task_ApplySub" targetRef="GW_Join" />
      <bpmn:sequenceFlow id="Flow_S9" sourceRef="Script_RefundAll" targetRef="GW_Join" />
      <bpmn:sequenceFlow id="Flow_S10" sourceRef="GW_Join" targetRef="Task_IssueRefund" />
      <bpmn:sequenceFlow id="Flow_S11" sourceRef="Task_IssueRefund" targetRef="Task_NotifyRefund" />
      <bpmn:sequenceFlow id="Flow_S12" sourceRef="Task_NotifyRefund" targetRef="Script_Resolution" />
      <bpmn:sequenceFlow id="Flow_S13" sourceRef="Script_Resolution" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Timeout" name="Approval timeout" attachedToRef="Sub_Substitution">
      <bpmn:outgoing>Flow_W7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Sub">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=substitutionTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_RefundError" name="Refund failed" attachedToRef="Sub_Substitution">
      <bpmn:outgoing>Flow_W9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Refund" errorRef="Error_RefundFailed" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_AutoRefund" name="Auto-refund after timeout">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-refund-damaged" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId" />
          <zeebe:input source="=warehouseGroup.warehouseId" target="warehouseId" />
          <zeebe:input source="=damagedItems" target="damagedItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W7</bpmn:incoming>
      <bpmn:outgoing>Flow_W8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UT_ManualRefund" name="Manual refund review (finance)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:formDefinition formId="manual-refund-form" />
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;MANUAL_REFUND&#34;" target="resolution" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W9</bpmn:incoming>
      <bpmn:outgoing>Flow_W10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Merge">
      <bpmn:incoming>Flow_W5</bpmn:incoming>
      <bpmn:incoming>Flow_W6</bpmn:incoming>
      <bpmn:incoming>Flow_W8</bpmn:incoming>
      <bpmn:incoming>Flow_W10</bpmn:incoming>
      <bpmn:outgoing>Flow_W11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_Label" name="Generate carrier label (3PL)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="carrier_label_generation" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId" />
          <zeebe:input source="=warehouseGroup.warehouseId" target="warehouseId" />
          <zeebe:input source="=customer" target="customer" />
          <zeebe:input source="=shippingAddress" target="shippingAddress" />
          <zeebe:input source="=parcelWeightKg" target="parcelWeightKg" />
          <zeebe:output source="=labelResult" target="labelResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W11</bpmn:incoming>
      <bpmn:outgoing>Flow_W12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Task_MarkShipped" name="Mark shipped &#38; build result">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-shipped" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId" />
          <zeebe:input source="=warehouseGroup.warehouseId" target="warehouseId" />
          <zeebe:input source="=labelResult" target="labelResult" />
          <zeebe:input source="=resolution" target="resolution" />
          <zeebe:input source="=refundTotal" target="refundTotal" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W12</bpmn:incoming>
      <bpmn:outgoing>Flow_W13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_WH" name="Parcel shipped">
      <bpmn:incoming>Flow_W13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_W1" sourceRef="Start_WH" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_W2" sourceRef="Task_Register" targetRef="UT_Pick" />
    <bpmn:sequenceFlow id="Flow_W3" sourceRef="UT_Pick" targetRef="GW_Damaged" />
    <bpmn:sequenceFlow id="Flow_W4" name="Yes" sourceRef="GW_Damaged" targetRef="Sub_Substitution">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=damagedItems != null and count(damagedItems) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_W5" name="No" sourceRef="GW_Damaged" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="Flow_W6" sourceRef="Sub_Substitution" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="Flow_W7" sourceRef="Boundary_Timeout" targetRef="Task_AutoRefund" />
    <bpmn:sequenceFlow id="Flow_W8" sourceRef="Task_AutoRefund" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="Flow_W9" sourceRef="Boundary_RefundError" targetRef="UT_ManualRefund" />
    <bpmn:sequenceFlow id="Flow_W10" sourceRef="UT_ManualRefund" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="Flow_W11" sourceRef="GW_Merge" targetRef="Call_Label" />
    <bpmn:sequenceFlow id="Flow_W12" sourceRef="Call_Label" targetRef="Task_MarkShipped" />
    <bpmn:sequenceFlow id="Flow_W13" sourceRef="Task_MarkShipped" targetRef="End_WH" />
  </bpmn:process>
  <bpmn:error id="Error_RefundFailed" name="Refund failed" errorCode="REFUND_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_warehouse_pick_pack_ship">
    <bpmndi:BPMNPlane id="BPMNPlane_warehouse_pick_pack_ship" bpmnElement="warehouse_pick_pack_ship">
      <bpmndi:BPMNShape id="Start_WH_di" bpmnElement="Start_WH">
        <dc:Bounds x="152" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="125" y="423" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register">
        <dc:Bounds x="240" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_Pick_di" bpmnElement="UT_Pick">
        <dc:Bounds x="410" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Damaged_di" bpmnElement="GW_Damaged" isMarkerVisible="true">
        <dc:Bounds x="560" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="540" y="343" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkShipped_di" bpmnElement="Task_MarkShipped">
        <dc:Bounds x="2420" y="510" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_WH_di" bpmnElement="End_WH">
        <dc:Bounds x="2467" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2449" y="763" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Substitution_di" bpmnElement="Sub_Substitution" isExpanded="true">
        <dc:Bounds x="680" y="180" width="1520" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Start_di" bpmnElement="Sub_Start">
        <dc:Bounds x="710" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="683" y="423" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FindSub_di" bpmnElement="Task_FindSub">
        <dc:Bounds x="790" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_SubAvail_di" bpmnElement="GW_SubAvail" isMarkerVisible="true">
        <dc:Bounds x="960" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="343" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_ApproveSubstitution_di" bpmnElement="UT_ApproveSubstitution">
        <dc:Bounds x="1070" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Approved_di" bpmnElement="GW_Approved" isMarkerVisible="true">
        <dc:Bounds x="1230" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="203" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApplySub_di" bpmnElement="Task_ApplySub">
        <dc:Bounds x="1330" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_RefundAll_di" bpmnElement="Script_RefundAll">
        <dc:Bounds x="1195" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Join_di" bpmnElement="GW_Join" isMarkerVisible="true">
        <dc:Bounds x="1475" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IssueRefund_di" bpmnElement="Task_IssueRefund">
        <dc:Bounds x="1560" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRefund_di" bpmnElement="Task_NotifyRefund">
        <dc:Bounds x="1740" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_Resolution_di" bpmnElement="Script_Resolution">
        <dc:Bounds x="1920" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_End_di" bpmnElement="Sub_End">
        <dc:Bounds x="2100" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2073" y="423" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1">
        <di:waypoint x="746" y="400" />
        <di:waypoint x="790" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_di" bpmnElement="Flow_S2">
        <di:waypoint x="910" y="400" />
        <di:waypoint x="960" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S3_di" bpmnElement="Flow_S3">
        <di:waypoint x="985" y="375" />
        <di:waypoint x="985" y="260" />
        <di:waypoint x="1070" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S4_di" bpmnElement="Flow_S4">
        <di:waypoint x="985" y="425" />
        <di:waypoint x="985" y="520" />
        <di:waypoint x="1500" y="520" />
        <di:waypoint x="1500" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S5_di" bpmnElement="Flow_S5">
        <di:waypoint x="1190" y="260" />
